<?xml version="1.0" encoding="utf-8"?>
<rolemap>

  <permissions>

    <!-- Manage permissions -->
    <permission name="senaite.starter: Field: Edit Extended Field" acquire="False">
      <role name="Manager"/>
      <role name="LabManager"/>
      <role name="LabClerk"/>
    </permission>

    <!-- Patient field permissions. Same default roles that senaite.patient
         grants for its own patient fields (Owner = the sample creator).
         Workflow states can narrow this down (see setuphandlers.py) -->
    <permission name="senaite.starter: Field: Edit CNIC" acquire="False">
      <role name="Owner"/>
      <role name="LabClerk"/>
      <role name="LabManager"/>
      <role name="Manager"/>
    </permission>
    <permission name="senaite.starter: Field: Edit Patient Email" acquire="False">
      <role name="Owner"/>
      <role name="LabClerk"/>
      <role name="LabManager"/>
      <role name="Manager"/>
    </permission>
    <permission name="senaite.starter: Field: Edit Patient Phone" acquire="False">
      <role name="Owner"/>
      <role name="LabClerk"/>
      <role name="LabManager"/>
      <role name="Manager"/>
    </permission>

  </permissions>

</rolemap>

<configure
    xmlns="http://namespaces.zope.org/zope"
    i18n_domain="senaite.starter">

  <!-- senaite.patient creates the Patient from the sample in its handlers for
       these same events. Its ZCML is included before ours (see the package's
       configure.zcml), so these handlers are called after senaite.patient's.

       NOTE: IObjectInitializedEvent extends IObjectModifiedEvent and handlers
             for the more generic event are called first. So on sample
             creation, the patient always exists when `on_object_created` is
             called, regardless of the registration order. -->

  <!-- Sample modified -->
  <subscriber
      for="bika.lims.interfaces.IAnalysisRequest
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler=".analysisrequest.on_object_edited"
      />

  <!-- Sample created -->
  <subscriber
      for="bika.lims.interfaces.IAnalysisRequest
           Products.Archetypes.interfaces.IObjectInitializedEvent"
      handler=".analysisrequest.on_object_created"
      />

</configure>
